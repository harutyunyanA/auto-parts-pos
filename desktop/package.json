{
  "name": "desktop",
  "version": "1.0.0",
  "description": "Store desktop client (Electron)",
  "main": "main.js",
  "author": "harutyunyanA",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "dev": "VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:renderer": "npm --prefix ../frontend run build:app",
    "build": "npm run build:renderer && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "build": {
    "appId": "com.store.desktop",
    "productName": "Store",
    "asar": true,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../frontend/dist", "to": "renderer" }],
    "directories": { "output": "dist" },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
