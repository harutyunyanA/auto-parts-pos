# Frontend environment variables (Vite)
# Copy this file to .env and fill in real values.
# All vars must be prefixed with VITE_ to be exposed to the client bundle.

# Base URL of the backend API.
# Local dev default (if unset) is http://localhost:4000 — see src/api/client.ts.
# For deploy: set to your production backend URL, e.g. https://api.yourdomain.com
VITE_API_URL=http://localhost:4000
